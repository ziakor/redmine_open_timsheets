<h2><%= l(:label_open_timesheets_absence_new) %></h2>

<%= labelled_form_for @absence, url: timesheet_absences_path(user_id: params[:user_id]),
                      html: { method: :post } do |f| %>
  <%= render partial: 'timesheet_absences/form', locals: { f: f } %>
  <p>
    <%= submit_tag l(:button_create) %>
    <%= link_to l(:button_cancel), timesheet_absences_path(user_id: params[:user_id]) %>
  </p>
<% end %>
