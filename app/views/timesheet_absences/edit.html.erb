<h2><%= l(:label_open_timesheets_absence_edit) %></h2>

<%= labelled_form_for @absence, url: timesheet_absence_path(@absence, user_id: params[:user_id]),
                      html: { method: :put } do |f| %>
  <%= render partial: 'timesheet_absences/form', locals: { f: f } %>
  <p><%= submit_tag l(:button_save) %></p>
<% end %>
